# =====================================================================
# 향미옥 경영관리 — 환경변수 예시
# 이 파일을 복사해 `.env.local` 을 만들고 값을 채우세요. (.env.local 은 Git 에 올라가지 않습니다)
# 개발용과 운영용은 **서로 다른 Supabase 프로젝트**를 사용하세요. (테스트 데이터와 실적 분리)
# =====================================================================

# Supabase 대시보드 → Project Settings → API (또는 API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). 구 프로젝트는 anon key 를 넣어도 됩니다. 브라우저에 노출돼도 되는 키입니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (sb_secret_...) 또는 구 service_role key. **절대 외부에 공유하지 마세요.**
# 계정 생성·비밀번호 초기화·로그인 차단에만 서버에서 사용됩니다.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 실행 환경: development | staging | production
# production 이 아니면 화면 상단에 '테스트 환경' 띠가 표시됩니다.
NEXT_PUBLIC_APP_ENV=development

# (선택) 이메일 없는 직원 아이디를 내부 이메일로 바꿀 때 쓰는 도메인. 실제 메일은 발송되지 않습니다.
# 한번 운영을 시작하면 바꾸지 마세요 (기존 직원이 로그인하지 못하게 됩니다).
AUTH_LOGIN_ID_DOMAIN=staff.hyangmiok.invalid
